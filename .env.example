DATABASE_URL="file:./dev.db"
# Or for PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/pkashop?schema=public"

# ⚠️ BẮT BUỘC: Tạo secret ngẫu nhiên cho production
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="pkashop-ultra-secret-jwt-key-2026-very-secure-random"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="PKASHOP"

# ─── Production checklist ──────────────────────────────────────────
# 1. Đổi JWT_SECRET thành chuỗi ≥32 ký tự ngẫu nhiên
# 2. Đặt NEXT_PUBLIC_APP_URL = https://your-domain.com
# 3. Nếu dùng PostgreSQL, bỏ comment DATABASE_URL phía trên
